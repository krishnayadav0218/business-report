# ---- Data source (used by src/main.py -- the scheduled version) ----
# One of: csv | excel | gsheet | sql | api
# NOTE: desktop_app.py ignores this -- it always uses whichever file you pick in the dialog.
DATA_SOURCE=csv
CSV_PATH=data/sample_sales_data.csv
EXCEL_PATH=data/sample_sales_data.xlsx

# Google Sheets (if DATA_SOURCE=gsheet)
GOOGLE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# SQL (if DATA_SOURCE=sql)
DB_ENGINE=postgresql
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
SQL_QUERY=SELECT * FROM sales;

# Third-party API (if DATA_SOURCE=api)
API_URL=

# ---- Web app (app.py) ----
# Set this when you deploy the web app publicly (e.g. on Render) so random
# people who find the URL can't use it. Leave blank for local-only testing.
APP_PASSWORD=

# ---- Email delivery (used by main.py, desktop_app.py, watch_folder.py, and app.py) ----
# EMAIL_PROVIDER = smtp (default -- works locally / GitHub Actions) or sendgrid
# (required on Render's free tier -- see README "Deploy as a web app" for setup)
EMAIL_PROVIDER=smtp

# --- smtp settings (used when EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# --- sendgrid settings (used when EMAIL_PROVIDER=sendgrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

REPORT_RECIPIENTS=manager@company.com,client@company.com
