# ---- Data source ----
# One of: csv | gsheet | sql | api
DATA_SOURCE=csv
CSV_PATH=data/sample_sales_data.csv

# Google Sheets (if DATA_SOURCE=gsheet)
GOOGLE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# SQL (if DATA_SOURCE=sql)
DB_ENGINE=postgresql
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
SQL_QUERY=SELECT * FROM sales;

# Third-party API (if DATA_SOURCE=api)
API_URL=

# ---- Email delivery ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_RECIPIENTS=manager@company.com,client@company.com
